{
  "$schema": "https://typedoc.org/schema.json",
  "name": "measurekit",
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/core", "packages/psychometrics", "packages/knowledge-tracing"],
  "readme": "README.md",
  "out": "docs/api",
  "router": "structure-dir",
  "favicon": "docs/favicon.svg",
  "treatWarningsAsErrors": true,
  "plugin": ["typedoc-plugin-mermaid", "./docs/typedoc-seo.ts"],
  "mermaidVersion": "11.17.2",
  "customCss": "docs/diagrams.css",
  "ignoredHighlightLanguages": ["python", "r"]
}
