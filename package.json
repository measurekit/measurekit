{
  "name": "measurekit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "pnpm -r --workspace-concurrency=1 bench",
    "lint": "biome check . && cspell --no-progress",
    "format": "biome check --write .",
    "knip": "knip",
    "docs:api": "typedoc",
    "check:packages": "pnpm -r check:packages",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.0.0",
    "cspell": "^10.4.0",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "publint": "^0.3.25",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0"
}
