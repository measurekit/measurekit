{
  "name": "measurekit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --project core --project psychometrics --project knowledge-tracing",
    "bench": "pnpm -r --workspace-concurrency=1 bench",
    "lint": "biome check . && cspell --no-progress",
    "check:standards": "node scripts/check-standards.ts",
    "format": "biome check --write .",
    "knip": "knip",
    "docs:api": "pnpm build && typedoc",
    "check:packages": "pnpm -r check:packages",
    "check:rules": "node scripts/check-rules.ts",
    "check:licenses": "node scripts/check-licenses.ts",
    "check:release": "node scripts/check-release.ts",
    "check:tarballs": "pnpm build && node scripts/check-tarballs.ts",
    "check:audit": "pnpm audit --prod && pnpm audit --audit-level=high",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepare": "node scripts/prepare.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "cspell": "10.4.0",
    "esbuild": "0.28.2",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "publint": "0.3.25",
    "typedoc": "0.28.20",
    "typedoc-plugin-mermaid": "1.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "license": "Apache-2.0"
}
