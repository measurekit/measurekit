{
  "name": "@measurekit/psychometrics",
  "version": "0.0.0",
  "description": "Psychometrics for JavaScript and TypeScript: classical test theory, item response theory including multidimensional models, cognitive diagnosis (G-DINA, DINA, DINO, A-CDM, LLM, R-RUM), adaptive testing including cognitive diagnosis and multidimensional tests, item fit, differential item functioning, equating, score scaling and prediction, dimensionality (polychoric correlations and parallel analysis), explanatory models of item difficulty, generalizability theory, Mokken scale analysis, simulation, standard setting, rater agreement and effects, response times, and answer similarity for copying and collusion, validated against R.",
  "keywords": [
    "psychometrics",
    "classical-test-theory",
    "item-response-theory",
    "irt",
    "multidimensional-irt",
    "computerized-adaptive-testing",
    "multistage-testing",
    "testlets",
    "item-analysis",
    "reliability",
    "cronbach-alpha",
    "subscores",
    "assessment",
    "item-fit",
    "differential-item-functioning",
    "mantel-haenszel",
    "polytomous-items",
    "test-equating",
    "explanatory-irt",
    "generalizability-theory",
    "mokken-scale-analysis",
    "variance-components",
    "score-scaling",
    "scale-scores",
    "percentile-ranks",
    "simulation",
    "standard-setting",
    "rater-agreement",
    "many-facet-rasch",
    "rater-severity",
    "cohen-kappa",
    "percent-agreement",
    "intraclass-correlation",
    "response-times",
    "speed-accuracy",
    "rapid-guessing",
    "answer-copying",
    "answer-similarity",
    "test-security",
    "cognitive-diagnosis",
    "gdina",
    "acdm",
    "rrum",
    "dimensionality",
    "parallel-analysis",
    "polychoric-correlation",
    "tetrachoric-correlation"
  ],
  "author": "Fariz Wakan (https://github.com/luthfanwakan)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/measurekit/measurekit.git",
    "directory": "packages/psychometrics"
  },
  "homepage": "https://github.com/measurekit/measurekit/tree/main/packages/psychometrics#readme",
  "bugs": "https://github.com/measurekit/measurekit/issues",
  "type": "module",
  "sideEffects": false,
